# Configurazione per lo sviluppo locale: copiare in .env nella radice del repository
# (cp .env.example .env). Lo leggono tutti i componenti Python avviati in locale, senza
# bisogno di export; un .env nella cartella di avvio, se presente, prevale, e le variabili
# d'ambiente prevalgono su entrambi. Docker compose lo usa per i valori ${...} del
# docker-compose.yml (es. LLM_PROVIDER, LLM_API_KEY, LOG_LEVEL).
# Il .env non va nel repository (.gitignore) né nelle immagini (.dockerignore):
# in Kubernetes gli stessi nomi arrivano da ConfigMap e Secret.

DATABASE_URL=mysql+aiomysql://atti_pa:password@localhost:3306/atti_pa

# Log: DEBUG (diagnostica dettagliata), INFO (normale), WARNING (solo anomalie), ERROR
LOG_LEVEL=DEBUG
# LOG_SQL=true   # con LOG_LEVEL=DEBUG registra anche le query SQL

# Uso personale senza Active Directory
AUTH_ENABLED=false
COOKIE_SECURE=false
JWT_SECRET=sviluppo-locale-non-usare-in-produzione
# Origini ammesse per l'app Flutter in sviluppo (flutter run usa una porta casuale):
# qualunque porta di localhost. Le voci sono espressioni regolari: tenere ^ e $.
CORS_ORIGINI=["^http://localhost:[0-9]+$", "^http://127\\.0\\.0\\.1:[0-9]+$"]
# In locale non c'è l'Ingress davanti all'API: le intestazioni X-Forwarded-* non sono fidate
PROXY_HOPS=0

# Active Directory (con AUTH_ENABLED=true)
LDAP_URL=ldaps://dc.ente.local
# LDAP_CA_CERT=/percorso/ca.pem          # CA che ha firmato il certificato del DC
# LDAP_VERIFICA_CERTIFICATO=false        # solo per prove: non verifica il certificato LDAPS
LDAP_DOMINIO=ente.local
LDAP_BASE_DN=DC=ente,DC=local
LDAP_GRUPPO_REDATTORI=ATTI-PA-Redattori
LDAP_GRUPPO_CONTROLLORI=ATTI-PA-Controllori
LDAP_GRUPPO_GESTORI_MODELLI=ATTI-PA-Gestori-Modelli   # modificano modelli e checklist in bozza
LDAP_GRUPPO_ADMIN=ATTI-PA-Admin

# Normattiva (test: https://pre.api.normattiva.it/t/normattiva.api)
NORMATTIVA_BASE_URL=https://api.normattiva.it/t/normattiva.api

# LLM. Provider:
#   ollama (predefinito), openai_compatibile (vLLM, llama.cpp): on-premise
#   openai (ChatGPT), gemini (Google), anthropic (Claude): servizi esterni, il testo degli
#   atti (dati personali compresi) esce dall'ente
LLM_PROVIDER=ollama
# Vuoti = predefiniti del provider (ollama: http://localhost:11434/v1 e mistral-small;
# openai: gpt-5-mini; gemini: gemini-2.5-flash; anthropic: claude-opus-5-5)
LLM_BASE_URL=
LLM_MODEL=
# LLM_OLLAMA_URL=http://localhost:11434/v1   # indirizzo di Ollama se LLM_BASE_URL è vuoto
# Obbligatoria per openai e gemini; per anthropic, se vuota, vale ANTHROPIC_API_KEY
LLM_API_KEY=
# Solo anthropic:
# LLM_EFFORT=medium        # low | medium | high | xhigh | max
# LLM_MAX_TOKEN=16000
# LLM_FALLBACK=true        # se Claude rifiuta una richiesta, riprova su un altro modello

# Code RabbitMQ tra API, converter e worker (docker compose espone RabbitMQ sulla 5673)
RABBITMQ_URL=amqp://atti_pa:password@localhost:5673/
# RABBITMQ_PREFISSO=atti-pa
# Archivio dei file originali degli atti: percorso ASSOLUTO di una cartella scrivibile,
# la stessa per API e converter (ognuno parte da una cartella diversa)
ARCHIVIO_DIR=/percorso/assoluto/atti-pa/archivio
# WORKER_REINVIO_MINUTI=10   # lavori fermi reinviati sulle code dopo questo tempo

# Servizio di conversione (converter, LibreOffice), avviato in locale sulla porta 8001
DOCUMENTI_URL=http://localhost:8001
# SOFFICE_BIN=soffice
# CONVERSIONI_PARALLELE=2
# CONVERSIONE_TIMEOUT=120

# Altre impostazioni con il loro valore predefinito (common/config.py)
# FUSO_ORARIO=Europe/Rome
# NORMATTIVA_TIMEOUT=30
# NORMATTIVA_TENTATIVI=3
# LDAP_TIMEOUT=10
# JWT_SCADENZA_MINUTI=480
# UPLOAD_MAX_MB=20
# SYNC_GIORNI_INIZIALI=7
# SYNC_FINESTRA_GIORNI=7
# SYNC_PAUSA_SECONDI=0.5
# WORKER_INTERVALLO_SECONDI=5
# WORKER_MAX_TENTATIVI=3
# ENV_FILE=/percorso/altro.env   # (solo come variabile d'ambiente) file .env alternativo
# LLM_TIMEOUT=180
# LLM_TIMEOUT_REDAZIONE=60
# LLM_TEMPERATURA=0
# LLM_TEMPERATURA_REDAZIONE=0.2
# LLM_MAX_CARATTERI_ATTO=60000
# Coerenza tra riferimenti normativi citati e contenuto dell'atto (nelle verifiche, con LLM)
# LLM_COERENZA_RIFERIMENTI=true
# LLM_COERENZA_GRUPPO=8                  # riferimenti per chiamata all'LLM
# LLM_COERENZA_MAX_CARATTERI_NORMA=8000  # testo massimo di una norma nel prompt
# LLM_RICONOSCIMENTO_NORME_MANUALI=true  # citazioni di regolamenti interni non riconosciute dalle denominazioni
# LLM_DATI_PERSONALI=true          # dati personali da oscurare (omissis) rilevati dal modello
# Modelli di atto, specificità e checklist: comanda il database. Al primo avvio, con il
# database vuoto, l'API importa il pacchetto standard (manifesto pacchetto.yaml, cartelle
# modelli/ e checklist/); gli aggiornamenti si importano da Amministrazione
# IMPORTA_PACCHETTO_INIZIALE=true
# PACCHETTO_DIR=deploy             # predefinita: la cartella deploy del repository
# LLM_PROMPT_DIR=/percorso/prompt   # prompt personalizzati (predefiniti: common/prompt/)
# DOCUMENTI_TIMEOUT=150
# WORKER_TIMEOUT_MINUTI=60
# WORKER_HEARTBEAT=/tmp/heartbeat
# Server gunicorn di API e servizio documenti (vedi */gunicorn_conf.py):
# WEB_HOST=0.0.0.0  WEB_PORT=8000  WEB_WORKERS=2  WEB_THREADS=8  WEB_TIMEOUT=60
# WEB_GRACEFUL_TIMEOUT=25  WEB_KEEPALIVE=65
# (le variabili WEB_* sono lette da gunicorn dall'ambiente, non da questo file)
# Avvio in locale senza gunicorn (dalle cartelle src):
#   api:       PYTHONPATH=../.. python -m flask --app "main:create_app()" run --port 8000
#   converter: python -m flask --app "main:create_app()" run --port 8001
#   consumatore della conversione: cd converter/src && python consumatore.py
#   worker:    cd verifica-worker/src && PYTHONPATH=../.. python __main__.py
