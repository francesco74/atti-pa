# Variabili per lo sviluppo locale (copiare in .env nella cartella del componente).
# In Kubernetes gli stessi nomi arrivano da ConfigMap e Secret.

DATABASE_URL=mysql+aiomysql://atti_pa:password@localhost:3306/atti_pa

# Uso personale senza Active Directory
AUTH_ENABLED=false
COOKIE_SECURE=false
JWT_SECRET=sviluppo-locale-non-usare-in-produzione
# CORS_ORIGINI=["http://localhost:5000"]

# Active Directory (con AUTH_ENABLED=true)
LDAP_URL=ldaps://dc.ente.local
LDAP_DOMINIO=ente.local
LDAP_BASE_DN=DC=ente,DC=local
LDAP_GRUPPO_REDATTORI=ATTI-PA-Redattori
LDAP_GRUPPO_CONTROLLORI=ATTI-PA-Controllori
LDAP_GRUPPO_ADMIN=ATTI-PA-Admin

# Normattiva (test: https://pre.api.normattiva.it/t/normattiva.api)
NORMATTIVA_BASE_URL=https://api.normattiva.it/t/normattiva.api

# LLM on-premise compatibile OpenAI (vLLM, Ollama, llama.cpp)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=mistral-small

# Servizio documenti (LibreOffice)
DOCUMENTI_URL=http://localhost:8001
