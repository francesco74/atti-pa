# Normattiva
NORMATTIVA_BASE_URL=https://api.normattiva.it/t/normattiva.api
# Ambiente di test: https://pre.api.normattiva.it/t/normattiva.api
NORMATTIVA_TIMEOUT=30

# Database
DATABASE_URL=mysql+aiomysql://atti_pa:password@localhost:3306/atti_pa

# LLM on-premise (OpenAI-compatible, es. vLLM o Ollama)
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=mistral-small

# Autenticazione (false = uso personale senza login)
AUTH_ENABLED=false
LDAP_URL=ldaps://dc.ente.local
LDAP_BASE_DN=DC=ente,DC=local
JWT_SECRET=cambiami
