# Configurazione dell'installazione Docker: copiare in .env e compilare. Il .env resta solo
# sul server (contiene password e chiavi): permessi 600, mai nel repository.

# Versione delle immagini francesco74/atti-pa-* su Docker Hub
VERSIONE=0.2.0

# Dominio principale e email per Let's Encrypt (avvisi sui certificati). I domini degli
# enti (es. provincia.attipa.papuntozero.it) si registrano con enti.py: il DNS deve avere
# un record per DOMINIO e uno wildcard *.DOMINIO verso questo server.
DOMINIO=attipa.papuntozero.it
ACME_EMAIL=

# Password e chiavi: casuali, solo lettere e cifre (finiscono negli URL di connessione).
# Generarle con: openssl rand -hex 32
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
RABBITMQ_PASSWORD=
RABBITMQ_COOKIE=
# sessioni (almeno 32 caratteri) e cifratura delle chiavi dei servizi collegati nel database
# (se cambia, le chiavi salvate vanno reinserite)
JWT_SECRET=
CHIAVE_CIFRATURA=
# password dell'admin di ogni nuovo ente, da cambiare al primo accesso: almeno 16
# caratteri (è un amministratore; 8 per gli altri utenti), con lettere e numeri o simboli
PASSWORD_INIZIALE=

# LLM: Gemini (Google). Gli atti inviati all'LLM escono dall'ente.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=

# Ricerca per significato con gli embedding di Gemini (API compatibile OpenAI); i testi
# di processi, procedimenti e delle domande vanno a Google. Vuoti = ricerca solo per parole.
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_API_KEY=

# OCR delle pagine scansionate dei PDF (converter): con Gemini, la stessa chiave. Senza
# chiave i PDF scansionati sono rifiutati. Le pagine scansionate vanno a Google.
OCR_PROVIDER=gemini
OCR_MODEL=gemini-3-flash-preview
OCR_API_KEY=

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
