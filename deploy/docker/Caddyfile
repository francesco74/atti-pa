# Caddy davanti ad atti-pa (installazione Docker): fa quello che nel cluster fa l'Ingress.
# - https per tutti i domini; da http si passa a https (il cookie di sessione è Secure)
# - /api all'API, il resto all'app web, sullo stesso dominio (niente CORS)
# - certificati Let's Encrypt ottenuti e rinnovati da Caddy:
#     DOMINIO (es. attipa.papuntozero.it) all'avvio;
#     i domini degli enti (es. provincia.attipa.papuntozero.it) alla prima visita ("on
#     demand"), solo se l'API conferma che il dominio è di un ente attivo: un nome inventato
#     non genera richieste a Let's Encrypt.
# Limiti e timeout come l'Ingress: 25 MB per richiesta, 180 s di attesa (LLM_TIMEOUT_REDAZIONE
# e DOCUMENTI_TIMEOUT restano sotto). Connessioni riusate per 60 s, meno dei 65 s di keep-alive
# di gunicorn: non è mai l'API a chiudere una connessione che Caddy sta per riusare.

{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://api:8000/api/v1/tls/consenti
	}
}

(atti-pa) {
	# verifica dei domini: solo per Caddy, dall'interno
	handle /api/v1/tls/* {
		respond 404
	}
	handle /api/* {
		request_body {
			max_size 25MB
		}
		reverse_proxy api:8000 {
			transport http {
				dial_timeout 10s
				read_timeout 180s
				write_timeout 180s
				keepalive 60s
			}
		}
	}
	handle {
		reverse_proxy frontend:8080 {
			transport http {
				keepalive 60s
			}
		}
	}
	header Strict-Transport-Security "max-age=31536000"
}

{$DOMINIO} {
	import atti-pa
}

# domini degli enti
https:// {
	tls {
		on_demand
	}
	import atti-pa
}
